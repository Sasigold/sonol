# Sonol Field Ops — משתני סביבה
#
# העתיקו את הקובץ הזה ל-.env ומלאו את הערכים:
#   cp .env.example .env
#
# ⚠️  אין להוסיף את .env ל-git. הוא מופיע ב-.gitignore.
#
# רק שני המשתנים האלה מגיעים לדפדפן. מפתח ה-service_role לעולם לא נמצא כאן —
# מקומו היחיד הוא ב-Edge Functions, כמשתנה סביבה בצד השרת.

# כתובת הפרויקט ב-Supabase (Project Settings → API → Project URL)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# מפתח anon / publishable (Project Settings → API → anon public)
# המפתח הזה ציבורי מעצם הגדרתו. מה שמגן על הנתונים הוא RLS, ולא סודיות המפתח.
VITE_SUPABASE_ANON_KEY=your-anon-key-here
